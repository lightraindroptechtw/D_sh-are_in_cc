{
  "name": "d-sh-are-in-cc",
  "version": "0.2.0-beta.2",
  "description": "讓 DSH 社群的插件能夠在 Claude Code 使用：先下載審查、白話說明風險，你同意才轉換安裝。Use DSH (DeepSeek Harness) community plugins in Claude Code.",
  "author": {
    "name": "lightraindroptechtw",
    "url": "https://github.com/lightraindroptechtw"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "converter",
    "security-review"
  ],
  "types": "./types/index.d.ts",
  "mcpServers": {
    "DSH-market": {
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "--disable-warning=ExperimentalWarning",
        "${CLAUDE_PLUGIN_ROOT}/bin/market-server.mjs"
      ]
    }
  }
}
